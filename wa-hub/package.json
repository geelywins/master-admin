{
  "name": "wa-hub",
  "version": "1.0.3",
  "description": "Gabungkan banyak akun WhatsApp Web dalam satu aplikasi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.wins.wahub",
    "productName": "WA Hub",
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "geelywins",
        "repo": "master-admin"
      }
    ],
    "nsis": {
      "artifactName": "WA-Hub-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "WA-Hub-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "displayVersion": "1.0.2.1"
}
